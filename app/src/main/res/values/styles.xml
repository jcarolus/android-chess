<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ChessButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/surfaceTextColor</item>
        <item name="android:tint">@color/primaryTextColor</item>
        <item name="android:backgroundTint">@color/imagebutton_background</item>
        <item name="rippleColor">@color/secondaryVariantColor</item>
        <item name="android:layout_height">@dimen/imageButtonSize</item>
        <item name="android:layout_margin">4dip</item>
    </style>

    <!--
        Toggle group children, colour mode. Identical to ChessButton minus the
        layout_height and layout_margin items: those are inert when a style
        arrives through materialButtonStyle, but a toggle child references this
        with an explicit style=, which activates them and pushes the children
        apart instead of leaving them flush.
    -->
    <style name="ChessToggleButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/surfaceTextColor</item>
        <item name="android:tint">@color/primaryTextColor</item>
        <item name="android:backgroundTint">@color/imagebutton_background</item>
        <item name="rippleColor">@color/secondaryVariantColor</item>
    </style>

    <!--
        E-ink buttons: white fill, black outline, black text/icons, nothing that
        animates. A filled button is a solid block on a reflective panel that
        swamps the glyph and leaves a large ghosting area on press.
    -->
    <style name="ChessImageButtonEink" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="enforceMaterialTheme">true</item>
        <item name="enforceTextAppearance">false</item>
        <item name="android:textColor">@color/eink_button_foreground</item>
        <item name="android:tint">@color/eink_button_foreground</item>
        <item name="iconTint">@color/eink_button_foreground</item>
        <item name="backgroundTint">@color/eink_button_background</item>
        <item name="android:backgroundTint">@color/eink_button_background</item>
        <item name="strokeColor">@color/eink_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="android:layout_width">@dimen/imageButtonSize</item>
        <item name="android:layout_height">@dimen/imageButtonSize</item>
        <item name="android:padding">0dip</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="minWidth">0dp</item>
        <item name="minHeight">0dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:layout_margin">4dip</item>
    </style>

    <!--
        Standalone text buttons use the same paired state lists as icon buttons:
        white fill and black labels normally, inverted while pressed. Keep the
        Material backgroundTint attribute so the shape retains its black stroke.
    -->
    <style name="ChessButtonEink" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="enforceMaterialTheme">true</item>
        <item name="enforceTextAppearance">false</item>
        <item name="android:textColor">@color/eink_button_foreground</item>
        <item name="iconTint">@color/eink_button_foreground</item>
        <item name="backgroundTint">@color/eink_button_background</item>
        <item name="strokeColor">@color/eink_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_height">@dimen/imageButtonSize</item>
        <item name="android:layout_margin">4dip</item>
    </style>

    <!--
        Toggle group children render correctly, so they keep the inverting
        lists: white with a black label when unselected, black with a white
        label when selected.
    -->
    <style name="ChessToggleButtonEink" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="enforceMaterialTheme">true</item>
        <item name="enforceTextAppearance">false</item>
        <item name="android:textColor">@color/eink_button_foreground</item>
        <item name="iconTint">@color/eink_button_foreground</item>
        <item name="backgroundTint">@color/eink_button_background</item>
        <item name="strokeColor">@color/eink_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ChessImageButton" parent="Widget.Material3.Button.Icon">
        <item name="enforceMaterialTheme">true</item>
        <item name="enforceTextAppearance">false</item>
        <item name="android:textColor">@color/surfaceTextColor</item>
        <item name="android:tint">@color/primaryTextColor</item>
        <item name="android:backgroundTint">@color/imagebutton_background</item>
        <item name="rippleColor">@color/secondaryVariantColor</item>
        <item name="android:layout_width">@dimen/imageButtonSize</item>
        <item name="android:layout_height">@dimen/imageButtonSize</item>
        <item name="android:padding">0dip</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="minWidth">0dp</item>
        <item name="minHeight">0dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:layout_margin">4dip</item>
    </style>

    <style name="ChessTextAppearance" parent="@android:style/TextAppearance">
        <item name="android:typeface">sans</item>
    </style>

    <style name="MyTextStyle" parent="ChessTextAppearance">
        <item name="android:paddingTop">@dimen/normalPaddingY</item>
        <item name="android:paddingBottom">@dimen/normalPaddingY</item>
        <item name="android:paddingLeft">@dimen/normalPaddingX</item>
        <item name="android:paddingRight">@dimen/normalPaddingX</item>
        <item name="android:textSize">@dimen/normalTextSize</item>
    </style>

    <style name="MyHeaderTextStyle" parent="@style/MyTextStyle">
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:paddingTop">@dimen/headerPaddingY</item>
        <item name="android:paddingBottom">@dimen/headerPaddingY</item>
        <item name="android:paddingLeft">@dimen/headerPaddingX</item>
        <item name="android:paddingRight">@dimen/headerPaddingX</item>
    </style>

    <style name="MyTitleTextStyle" parent="@style/MyTextStyle">
        <item name="android:textSize">@dimen/titleTextSize</item>
    </style>

    <style name="MyLabelTextStyle">
        <item name="android:typeface">sans</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MyNormalTextStyle">
        <item name="android:gravity">center_vertical</item>
        <item name="android:typeface">sans</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MyRowTextStyle" parent="@style/MyTextStyle">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MySmallTextStyle">
        <item name="android:padding">2dip</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MyPaneTextStyle" parent="@style/MySmallTextStyle">
        <item name="android:padding">4dip</item>
        <item name="android:background">?attr/paneBackground</item>
        <item name="android:scrollHorizontally">false</item>
    </style>

    <style name="MyPaneTextStyle2Lines" parent="@style/MyPaneTextStyle">
        <item name="android:singleLine">false</item>
        <item name="android:minLines">2</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CaptureImageStyle">
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_width">30dp</item>
    </style>

    <style name="CaptureTextStyle">
        <item name="android:gravity">center</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_height">wrap_content</item><!-- 14dip -->
        <item name="android:layout_width">30dp</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="CaptureTextStyleSmall" parent="@style/CaptureTextStyle">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_marginLeft">0dp</item>
    </style>

    <style name="MyRowStyle">
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="MyFormLayout">
        <item name="android:layout_width">300dip</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="MyFormCardView" parent="MyFormLayout">
        <item name="android:padding">8dip</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="MySwitchStyle" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_color</item>
    </style>

    <!-- Greyscale switch: state reads from thumb position and darkness, not hue. -->
    <!--
        Outlined monochrome switch. Tints are cleared and explicit track/thumb
        drawables supplied, because a tint can only fill a shape, and a grey fill
        is exactly what we are trying to avoid.
    -->
    <style name="MySwitchStyleEink" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="android:thumb">@drawable/eink_switch_thumb</item>
        <item name="track">@drawable/eink_switch_track</item>
        <item name="android:textColor">@color/einkForeground</item>
        <item name="useMaterialThemeColors">false</item>
        <!--
            The stock Material track is a nine-patch carrying its own padding, so
            the label never touched it. A plain shape has none, which left the
            text butted against the outline.
        -->
        <!--
            No android: prefix. SwitchMaterial extends SwitchCompat, which reads
            switchPadding from its own styleable; the framework attribute of the
            same name is silently ignored.
        -->
        <item name="switchPadding">10dp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>
</resources>
