<resources>

    <style name="ChessTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="chessToggleButtonStyle">@style/ChessToggleButton</item>
        <item name="chessButtonStyle">@style/ChessButton</item>
        <item name="chessImageButtonStyle">@style/ChessImageButton</item>
        <item name="paneBackground">@color/paneBackgroundColor</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryVariantColor</item>
        <item name="colorOnPrimary">@color/primaryTextColor</item>
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryVariantColor</item>
        <item name="colorOnSecondary">@color/secondaryTextColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/surfaceTextColor</item>
        <item name="colorControlHighlight">@color/secondaryColor</item>
        <item name="rippleColor">@color/secondaryColor</item>
        <item name="switchStyle">@style/MySwitchStyle</item>
        <item name="materialButtonStyle">@style/ChessButton</item>
        <item name="materialAlertDialogTheme">@style/ChessAlertDialogTheme</item>
    </style>

    <style name="ChessStart" parent="Theme.Material3.DayNight">
        <item name="chessToggleButtonStyle">@style/ChessToggleButton</item>
        <item name="chessButtonStyle">@style/ChessButton</item>
        <item name="chessImageButtonStyle">@style/ChessImageButton</item>
        <item name="paneBackground">@color/paneBackgroundColor</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryVariantColor</item>
        <item name="colorOnPrimary">@color/primaryTextColor</item>
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryVariantColor</item>
        <item name="colorOnSecondary">@color/secondaryTextColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/surfaceTextColor</item>
        <item name="colorControlHighlight">@color/secondaryColor</item>
        <item name="rippleColor">@color/secondaryColor</item>
        <item name="actionBarStyle">@style/Widget.MyApp.ActionBar</item>
        <item name="switchStyle">@style/MySwitchStyle</item>
        <item name="materialButtonStyle">@style/ChessButton</item>
        <item name="materialAlertDialogTheme">@style/ChessAlertDialogTheme</item>
    </style>

    <style name="Widget.MyApp.ActionBar" parent="Widget.AppCompat.Light.ActionBar.Solid">
        <item name="background">@color/primaryColor</item>
    </style>

    <style name="ChessDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="chessToggleButtonStyle">@style/ChessToggleButton</item>
        <item name="chessButtonStyle">@style/ChessButton</item>
        <item name="chessImageButtonStyle">@style/ChessImageButton</item>
        <item name="paneBackground">@color/paneBackgroundColor</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryVariantColor</item>
        <item name="colorOnPrimary">@color/primaryTextColor</item>
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryVariantColor</item>
        <item name="colorOnSecondary">@color/secondaryTextColor</item>
        <item name="colorOnSurface">@color/surfaceTextColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorControlHighlight">@color/secondaryColor</item>
        <item name="rippleColor">@color/secondaryColor</item>
        <item name="switchStyle">@style/MySwitchStyle</item>
        <item name="materialButtonStyle">@style/ChessButton</item>
    </style>

    <!--
        E-ink theme. Applied on top of ChessTheme / ChessStart via setTheme() when
        the einkTheme preference is on.

        Everything is pure black on white: reflective panels have no backlight, so
        mid-tone accents lose most of their contrast, and the saturated blues and
        greens above collapse into near-identical greys. Ripples and state list
        animators are removed because each is a short translucent animation that
        leaves a ghost on every tap.
    -->
    <style name="ChessThemeEink" parent="ChessTheme">
        <item name="chessToggleButtonStyle">@style/ChessToggleButtonEink</item>
        <item name="materialAlertDialogTheme">@style/ChessAlertDialogThemeEink</item>
        <item name="colorOutline">@color/einkForeground</item>
        <item name="colorOutlineVariant">@color/einkForeground</item>
        <item name="colorOnSurfaceVariant">@color/einkForeground</item>
        <item name="colorSurfaceVariant">@color/einkBackground</item>
        <item name="android:statusBarColor">@color/einkBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/einkForeground</item>
        <item name="android:textColorSecondary">@color/einkForeground</item>
        <item name="android:textColorHint">@color/einkForeground</item>
        <item name="switchStyle">@style/MySwitchStyleEink</item>
        <item name="chessButtonStyle">@style/ChessButtonEink</item>
        <item name="chessImageButtonStyle">@style/ChessImageButtonEink</item>
        <item name="paneBackground">@drawable/eink_pane_border</item>
        <item name="android:windowBackground">@color/einkBackground</item>
        <item name="colorPrimary">@color/einkBackground</item>
        <item name="colorPrimaryVariant">@color/einkBackground</item>
        <item name="colorOnPrimary">@color/einkForeground</item>
        <item name="colorSecondary">@color/einkBackground</item>
        <item name="colorSecondaryVariant">@color/einkBackground</item>
        <item name="colorOnSecondary">@color/einkForeground</item>
        <item name="colorSurface">@color/einkBackground</item>
        <item name="colorOnSurface">@color/einkForeground</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/ChessButtonEink</item>
    </style>

    <style name="ChessStartEink" parent="ChessStart">
        <item name="chessToggleButtonStyle">@style/ChessToggleButtonEink</item>
        <item name="materialAlertDialogTheme">@style/ChessAlertDialogThemeEink</item>
        <item name="colorOutline">@color/einkForeground</item>
        <item name="colorOutlineVariant">@color/einkForeground</item>
        <item name="colorOnSurfaceVariant">@color/einkForeground</item>
        <item name="colorSurfaceVariant">@color/einkBackground</item>
        <item name="android:statusBarColor">@color/einkBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/einkForeground</item>
        <item name="android:textColorSecondary">@color/einkForeground</item>
        <item name="android:textColorHint">@color/einkForeground</item>
        <item name="switchStyle">@style/MySwitchStyleEink</item>
        <item name="chessButtonStyle">@style/ChessButtonEink</item>
        <item name="chessImageButtonStyle">@style/ChessImageButtonEink</item>
        <item name="paneBackground">@drawable/eink_pane_border</item>
        <item name="colorPrimary">@color/einkBackground</item>
        <item name="colorPrimaryVariant">@color/einkBackground</item>
        <item name="colorOnPrimary">@color/einkForeground</item>
        <item name="colorSecondary">@color/einkBackground</item>
        <item name="colorSecondaryVariant">@color/einkBackground</item>
        <item name="colorOnSecondary">@color/einkForeground</item>
        <item name="colorSurface">@color/einkBackground</item>
        <item name="colorOnSurface">@color/einkForeground</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/ChessButtonEink</item>
    </style>

    <style name="ChessDialogThemeEink" parent="ChessDialogTheme">
        <item name="chessToggleButtonStyle">@style/ChessToggleButtonEink</item>
        <item name="materialAlertDialogTheme">@style/ChessAlertDialogThemeEink</item>
        <item name="colorOutline">@color/einkForeground</item>
        <item name="colorOutlineVariant">@color/einkForeground</item>
        <item name="colorOnSurfaceVariant">@color/einkForeground</item>
        <item name="colorSurfaceVariant">@color/einkBackground</item>
        <item name="android:statusBarColor">@color/einkBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/einkForeground</item>
        <item name="android:textColorSecondary">@color/einkForeground</item>
        <item name="android:textColorHint">@color/einkForeground</item>
        <item name="paneBackground">@drawable/eink_pane_border</item>
        <item name="chessButtonStyle">@style/ChessButtonEink</item>
        <item name="chessImageButtonStyle">@style/ChessImageButtonEink</item>
        <item name="android:windowBackground">@color/einkBackground</item>
        <item name="colorPrimary">@color/einkBackground</item>
        <item name="colorPrimaryVariant">@color/einkBackground</item>
        <item name="colorOnPrimary">@color/einkForeground</item>
        <item name="colorSecondary">@color/einkBackground</item>
        <item name="colorSecondaryVariant">@color/einkBackground</item>
        <item name="colorOnSecondary">@color/einkForeground</item>
        <item name="colorSurface">@color/einkBackground</item>
        <item name="colorOnSurface">@color/einkForeground</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="switchStyle">@style/MySwitchStyleEink</item>
        <item name="materialButtonStyle">@style/ChessButtonEink</item>
    </style>

    <style name="ChessAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/ChessButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ChessButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/ChessButton</item>
    </style>

    <!--
        Both e-ink themes inherited materialAlertDialogTheme from their parents,
        so every MaterialAlertDialog kept the colour button bar: the promotion
        picker, the exit and castle confirms, the create-new-line confirm.
    -->
    <style name="ChessAlertDialogThemeEink" parent="ChessAlertDialogTheme">
        <item name="buttonBarPositiveButtonStyle">@style/ChessButtonEink</item>
        <item name="buttonBarNegativeButtonStyle">@style/ChessButtonEink</item>
        <item name="buttonBarNeutralButtonStyle">@style/ChessButtonEink</item>
        <item name="colorSurface">@color/einkBackground</item>
        <item name="colorOnSurface">@color/einkForeground</item>
        <item name="android:textColorPrimary">@color/einkForeground</item>
        <item name="android:textColorSecondary">@color/einkForeground</item>
    </style>
</resources>
