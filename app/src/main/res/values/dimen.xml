    <dimen name="menu_padding_horizontal">@dimen/space_large</dimen>
    <dimen name="menu_padding_vertical">@dimen/space_regular</dimen>
    <dimen name="text_padding_horizontal">@dimen/space_medium</dimen>
    <dimen name="text_padding_vertical">@dimen/space_hairline</dimen>
    <dimen name="header_padding_horizontal">@dimen/space_medium</dimen>
    <dimen name="header_padding_vertical">@dimen/space_small</dimen>

