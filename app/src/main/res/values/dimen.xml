    <dimen name="space_large">16dp</dimen>
    <dimen name="space_extra_large">24dp</dimen>
    <dimen name="space_double_large">32dp</dimen>

    <!-- Layout roles keep independently adjustable spacing separate. -->
    <dimen name="screen_padding">@dimen/space_large</dimen>
    <dimen name="board_screen_padding">@dimen/space_small</dimen>
    <dimen name="list_screen_padding">@dimen/space_tiny</dimen>
    <dimen name="panel_padding">@dimen/space_medium</dimen>
    <dimen name="dialog_padding">@dimen/space_extra_large</dimen>
    <dimen name="section_gap">@dimen/space_large</dimen>
    <dimen name="control_gap">@dimen/space_medium</dimen>
    <dimen name="board_control_gap">@dimen/space_small</dimen>
    <dimen name="compact_control_gap">@dimen/space_small</dimen>
