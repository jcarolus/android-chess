    <dimen name="board_row_gap">@dimen/space_hairline</dimen>
    <dimen name="row_padding">@dimen/space_medium</dimen>
    <dimen name="compact_row_padding">@dimen/space_small</dimen>
    <dimen name="control_padding">@dimen/space_small</dimen>
    <dimen name="compact_control_padding">@dimen/space_tiny</dimen>
    <dimen name="content_indent">@dimen/space_large</dimen>
    <dimen name="preference_indent">@dimen/space_double_large</dimen>
