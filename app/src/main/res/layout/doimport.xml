<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="center"
    android:padding="@dimen/screen_padding">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/panel_padding">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/TextViewDoImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TableRow android:layout_margin="@dimen/control_gap">

                    <TextView
                        android:text="Added"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/control_gap" />

                    <TextView
                        android:id="@+id/TextViewDoImportCnt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="40dip"
                        android:layout_margin="@dimen/control_gap" />
                </TableRow>

                <TableRow android:layout_margin="@dimen/control_gap">

                    <TextView
                        android:text="Ignored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/control_gap" />

                    <TextView
                        android:id="@+id/TextViewDoImportCntFail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="40dip"
                        android:layout_margin="@dimen/control_gap" />
                </TableRow>
            </TableLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/ProgressDoImport"
                android:layout_width="match_parent"
                android:layout_height="4dip"
                app:trackColor="@color/primaryColor"
                android:indeterminate="true"
                android:visibility="invisible"
                android:layout_alignParentBottom="true" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
