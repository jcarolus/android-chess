<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/EmptyCollectionMenu"
        style="?attr/chessImageButtonStyle"
        android:layout_gravity="end"
        android:contentDescription="@string/button_menu_description"
        app:icon="@drawable/ic_three_dots_vertical" />

    <TextView
        style="@style/MyPaneTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/control_gap"
        android:accessibilityLiveRegion="polite"
        android:text="@string/collection_empty" />
</LinearLayout>
