<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding"
    android:paddingTop="@dimen/panel_padding"
    android:paddingEnd="@dimen/dialog_padding"
    android:paddingBottom="@dimen/panel_padding">

    <View
        android:id="@+id/ColorPreview"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="@dimen/control_gap" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_hue" />

    <com.google.android.material.slider.Slider
        android:id="@+id/SliderHue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="360" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_saturation" />

    <com.google.android.material.slider.Slider
        android:id="@+id/SliderColorSaturation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/color_lightness" />

    <com.google.android.material.slider.Slider
        android:id="@+id/SliderLightness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="1" />
</LinearLayout>
