<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0,1">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/savegame_white"
                    android:id="@+id/TextViewPlayerWhite"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:singleLine="true"
                    style="@style/MyHeaderTextStyle" />

                <TextView
                    android:text="@string/savegame_black"
                    android:id="@+id/TextViewPlayerBlack"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:singleLine="true"
                    style="@style/MyHeaderTextStyle" />

                <TextView
                    android:text="@string/gameslist_result_placeholder"
                    android:id="@+id/TextViewResult"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:singleLine="true"
                    style="@style/MyHeaderTextStyle" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/savegame_event"
                    android:id="@+id/TextViewEvent"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:singleLine="true"
                    style="@style/MyHeaderTextStyle" />

                <TextView
                    android:id="@+id/TextViewDate"
                    android:text="@string/gameslist_date_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/MyHeaderTextStyle" />

                <TextView
                    android:text="@string/gameslist_rating_placeholder"
                    android:id="@+id/TextViewRating"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    style="@style/MyHeaderTextStyle" />
            </TableRow>
        </TableLayout>

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:alignItems="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonOpen"
                android:text="@string/gameslist_open"
                android:layout_width="wrap_content"
                style="?attr/chessButtonStyle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonAnalyze"
                android:text="@string/gameslist_analyze"
                android:layout_width="wrap_content"
                style="?attr/chessButtonStyle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonEdit"
                android:text="@string/choice_edit"
                android:layout_width="wrap_content"
                style="?attr/chessButtonStyle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonDelete"
                android:text="@string/choice_delete"
                android:layout_width="wrap_content"
                style="?attr/chessButtonStyle" />
        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/TextViewWhitePieces"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap"
            android:minLines="2"
            android:accessibilityLiveRegion="none" />

        <TextView
            android:id="@+id/TextViewBlackPieces"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap"
            android:minLines="2"
            android:accessibilityLiveRegion="none" />
</LinearLayout>
