<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/StudiesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/StudyStatus"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/StudyFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyCollection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/study_collection" />

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/study_topic" />

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/study_author" />

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/study_name" />

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/study_chapter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/StudySurprise"
                    style="?attr/chessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/study_surprise" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/StudyOpen"
                    style="?attr/chessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/study_open_chapter" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/StudyDownloads"
            style="?attr/chessButtonStyle"
            android:layout_width="match_parent"
            android:text="@string/study_download_collections" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/StudyImport"
            style="?attr/chessButtonStyle"
            android:layout_width="match_parent"
            android:text="@string/study_import" />
    </LinearLayout>
</ScrollView>
