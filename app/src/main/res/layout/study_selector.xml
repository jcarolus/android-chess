<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/StudiesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ButtonMenu"
            app:icon="@drawable/ic_three_dots_vertical"
            android:contentDescription="@string/button_menu_description"
            android:layout_gravity="end"
            style="?attr/chessImageButtonStyle" />

        <TextView
            android:id="@+id/StudyStatus"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/StudyFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/study_topic" />

            <jwtc.android.chess.views.FixedDropdownView
                android:id="@+id/StudyEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/savegame_event" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/StudySurprise"
                    style="?attr/chessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/study_surprise" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/StudyOpen"
                    style="?attr/chessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/gameslist_open" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
