<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingStart="@dimen/control_padding"
    android:paddingEnd="@dimen/control_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ImageAnalysisTurn"
                android:layout_width="12dip"
                android:layout_height="12dip"
                android:layout_marginStart="@dimen/control_gap"
                android:layout_marginEnd="@dimen/control_gap"
                android:src="@drawable/turnwhite"
                android:contentDescription="@string/analysis_white_to_move" />

            <TextView
                android:id="@+id/TextViewLastMove"
                style="@style/MyPaneTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/control_gap"
                android:accessibilityLiveRegion="assertive" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonMenu"
                app:icon="@drawable/ic_three_dots_vertical"
                android:contentDescription="@string/button_menu_description"
                style="?attr/chessImageButtonStyle" />

        </LinearLayout>

        <TableLayout
            android:id="@+id/LayoutHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/MyRowStyle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ButtonPrevious"
                    app:icon="@drawable/ic_chevron_left"
                    android:contentDescription="@string/button_previous_move_description"
                    style="?attr/chessImageButtonStyle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/HistoryRecyclerView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/control_gap"
                    android:layout_marginEnd="@dimen/control_gap"
                    android:orientation="horizontal"
                    android:scrollbars="horizontal"
                    android:fadeScrollbars="false"
                    android:scrollbarAlwaysDrawHorizontalTrack="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ButtonNext"
                    app:icon="@drawable/ic_chevron_right"
                    android:contentDescription="@string/button_next_move_description"
                    style="?attr/chessImageButtonStyle" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/TextViewComment"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:lines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:hint="@string/analysis_comment_hint"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:alignItems="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonVariations"
                style="?attr/chessButtonStyle"
                android:layout_width="wrap_content"
                android:text="@string/study_variations"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonBackToMain"
                style="?attr/chessButtonStyle"
                android:layout_width="wrap_content"
                android:text="@string/analysis_back_to_main"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ButtonEngineMove"
                style="?attr/chessButtonStyle"
                android:layout_width="wrap_content"
                android:minWidth="0dp"
                android:textAllCaps="false"
                android:visibility="gone" />
        </com.google.android.flexbox.FlexboxLayout>

        <LinearLayout
            android:id="@+id/StudyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/StudyTitle"
                style="@style/MyPaneTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/StudyChapterTitle"
                style="@style/MyHeaderTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/StudyChapterNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/StudyPreviousChapter"
                    style="?attr/chessImageButtonStyle"
                    android:contentDescription="@string/study_previous_chapter"
                    app:icon="@drawable/ic_chevron_left" />

                <SeekBar
                    android:id="@+id/StudyChapterSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/study_chapter"
                    android:saveEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/StudyNextChapter"
                    style="?attr/chessImageButtonStyle"
                    android:contentDescription="@string/study_next_chapter"
                    app:icon="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:alignItems="center">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/SwitchEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ChessFlexItem"
                android:text="@string/analysis_engine"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/SwitchSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ChessFlexItem"
                android:text="@string/pref_sound"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/SwitchSpeech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ChessFlexItem"
                android:text="@string/pref_speech"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/SwitchAccessibilityDrag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ChessFlexItem"
                android:text="@string/pref_accessibility_drag"
                android:checked="false" />

        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/TextViewWhitePieces"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:accessibilityLiveRegion="none" />

        <TextView
            android:id="@+id/TextViewBlackPieces"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:accessibilityLiveRegion="none" />
    </LinearLayout>
</ScrollView>
