<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/control_padding"
    android:paddingEnd="@dimen/control_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/StudyPreviousMove"
                style="?attr/chessImageButtonStyle"
                android:contentDescription="@string/button_previous_move_description"
                app:icon="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/StudyReaderMove"
                style="@style/MyPaneTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/StudyNextMove"
                style="?attr/chessImageButtonStyle"
                android:contentDescription="@string/button_next_move_description"
                app:icon="@drawable/ic_chevron_right" />

        </LinearLayout>

        <TextView
            android:id="@+id/StudyReaderComment"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:lines="2"
            android:scrollbars="vertical"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/StudyReaderChapter"
            style="@style/MyHeaderTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/StudyReaderTitle"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/StudyReaderStatus"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/StudyReaderRetry"
            style="?attr/chessButtonStyle"
            android:layout_width="wrap_content"
            android:text="@string/study_retry"
            android:visibility="gone" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignItems="center"
            app:flexWrap="wrap">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/StudyShowComments"
                style="@style/ChessFlexItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/study_show_comments" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/StudyVariations"
                style="?attr/chessButtonStyle"
                android:layout_width="wrap_content"
                android:text="@string/study_variations" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/SwitchSpeech"
                style="@style/ChessFlexItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_speech" />

        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/TextViewWhitePieces"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/TextViewBlackPieces"
            style="@style/MyPaneTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
