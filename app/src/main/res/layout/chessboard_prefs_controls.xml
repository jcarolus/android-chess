<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/panel_padding">

        <jwtc.android.chess.views.FixedDropdownView
            android:id="@+id/DropdownPieceSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/chessboard_hint_piece_set" />

        <jwtc.android.chess.views.FixedDropdownView
            android:id="@+id/DropdownColorScheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/chessboard_hint_color_scheme" />

        <LinearLayout
            android:id="@+id/CustomColorControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_gap"
                android:text="@string/custom_square_colors" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ButtonCustomDarkColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/compact_control_gap"
                    android:layout_weight="1"
                    android:text="@string/custom_dark_square_color" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ButtonCustomLightColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/compact_control_gap"
                    android:layout_weight="1"
                    android:text="@string/custom_light_square_color" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/SliderSaturation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="1"
            android:valueFrom="0.5"
            android:valueTo="1.0"
            android:stepSize="0.05"
            android:layout_marginEnd="@dimen/preference_control_inset"
            android:layout_marginStart="@dimen/preference_control_inset" />

        <jwtc.android.chess.views.FixedDropdownView
            android:id="@+id/DropdownTileSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/chessboard_hint_tile_effect" />

        <CheckBox
            android:id="@+id/CheckBoxCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/control_gap"
            android:text="@string/pref_showCoords" />

        <CheckBox
            android:id="@+id/CheckBoxShowMoves"
            android:text="@string/pref_show_possible_moves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/control_gap" />

        <CheckBox
            android:id="@+id/CheckBoxUsePieceAnimation"
            android:text="@string/pref_use_piece_animation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/control_gap" />

        <CheckBox
            android:id="@+id/CheckBoxShowCapturedPieces"
            android:text="@string/pref_show_captured_pieces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <CheckBox
            android:id="@+id/CheckBoxUseSound"
            android:text="@string/pref_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <CheckBox
            android:id="@+id/CheckBoxUseHapticFeedback"
            android:text="@string/pref_haptic_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <CheckBox
            android:id="@+id/CheckBoxUseWakeLock"
            android:text="@string/pref_wakelock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_wakelock_desc" />

        <CheckBox
            android:id="@+id/CheckBoxFullscreen"
            android:text="@string/pref_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_fullscreen_desc" />

        <CheckBox
            android:id="@+id/CheckBoxForceNightMode"
            android:text="@string/pref_night_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_night_mode_desc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ButtonApplyEinkSettings"
            android:text="@string/pref_eink_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_eink_mode_desc" />

        <CheckBox
            android:id="@+id/CheckBoxDisableDrag"
            android:text="@string/pref_disable_drag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_disable_drag_desc" />

        <CheckBox
            android:id="@+id/CheckBoxEinkTheme"
            android:text="@string/pref_eink_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_eink_theme_desc" />

        <CheckBox
            android:id="@+id/CheckBoxReduceAnimations"
            android:text="@string/pref_reduce_animations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_gap"
            android:layout_marginStart="@dimen/control_gap"
            android:layout_marginEnd="@dimen/control_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_indent"
            android:layout_marginEnd="@dimen/control_gap"
            android:layout_marginBottom="@dimen/control_gap"
            android:text="@string/pref_reduce_animations_desc" />
    </LinearLayout>
</ScrollView>
