<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LayoutBoardBottom"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:padding="@dimen/compact_row_padding">

    <ImageView
        android:id="@+id/ImageBottomTurn"
        android:src="@drawable/turnempty"
        android:layout_height="12dip"
        android:layout_width="12dip"
        android:layout_marginStart="@dimen/control_gap"
        android:layout_marginEnd="@dimen/control_gap" />

    <TextView
        android:id="@+id/TextPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp" />
</LinearLayout>
