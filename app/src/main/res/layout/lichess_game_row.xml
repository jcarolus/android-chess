<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/control_gap"
    android:gravity="center">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="2"
        android:background="?attr/paneBackground">

        <TableRow
            android:paddingTop="@dimen/row_padding"
            android:paddingBottom="@dimen/compact_row_padding"
            android:paddingStart="@dimen/compact_row_padding"
            android:gravity="center">

            <ImageView
                android:id="@+id/image_turn_white"
                android:src="@drawable/turnempty"
                android:layout_height="12dip"
                android:layout_width="12dip"
                android:padding="@dimen/compact_control_padding" />

            <TextView
                android:id="@+id/text_time_white"
                android:textSize="16sp"
                android:text="00:00"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/compact_control_gap" />

            <TextView
                android:id="@+id/text_white"
                android:textSize="16sp"
                android:text="opponent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </TableRow>

        <TableRow
            android:paddingTop="@dimen/compact_row_padding"
            android:paddingBottom="@dimen/row_padding"
            android:paddingStart="@dimen/compact_row_padding"
            android:gravity="center">

            <ImageView
                android:id="@+id/image_turn_black"
                android:src="@drawable/turnempty"
                android:layout_height="12dip"
                android:layout_width="12dip"
                android:padding="@dimen/compact_control_padding" />

            <TextView
                android:id="@+id/text_time_black"
                android:textSize="16sp"
                android:text="00:00"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/compact_control_gap" />

            <TextView
                android:id="@+id/text_black"
                android:textSize="16sp"
                android:text="opponent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </TableRow>
    </TableLayout>
</RelativeLayout>
