<?xml version="1.0" encoding="utf-8"?>
<!-- Thumb when off: white, outlined so it stays visible on the white track. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/einkBackground" />
    <stroke
        android:width="1dp"
        android:color="@color/einkForeground" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>
