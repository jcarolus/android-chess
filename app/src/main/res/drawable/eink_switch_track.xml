<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: white, black outline, identical in both states. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/einkBackground" />
    <stroke
        android:width="1dp"
        android:color="@color/einkForeground" />
    <corners android:radius="9dp" />
    <size
        android:width="34dp"
        android:height="18dp" />
</shape>
