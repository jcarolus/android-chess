<?xml version="1.0" encoding="utf-8"?>
<!-- Text and icon colour, inverted against eink_button_background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/einkForeground" android:state_enabled="false" />
    <item android:color="@color/einkBackground" android:state_checked="true" />
    <item android:color="@color/einkBackground" android:state_pressed="true" />
    <item android:color="@color/einkForeground" />
</selector>
